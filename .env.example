# =================================================================
# MergeMate — Environment Configuration
# =================================================================

PROJECT_NAME=MergeMate
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=true

# Security & Authentication
SECRET_KEY=generate_a_secure_random_64_character_hex_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# PostgreSQL: postgresql+psycopg2://mergemate:mergemate_secure_pass_2026@localhost:5432/mergemate
# SQLite (Local Fallback): sqlite:///./mergemate.db
DATABASE_URL=sqlite:///./mergemate.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# GitHub App Configuration (Optional for initial demo, required for live GitHub PR comments)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# RSA Private Key in PEM format (escape newlines as \n or provide multiline block)
GITHUB_APP_PRIVATE_KEY=

# AI Review Engine
OPENAI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096

# Static Analysis & Security Engines
RUFF_ENABLED=true
BANDIT_ENABLED=true
SEMGREP_ENABLED=true
GITLEAKS_ENABLED=true
OSV_SCANNER_ENABLED=true

# Isolated Test Runner (Docker ephemeral containers)
ISOLATED_TESTING_ENABLED=false
CONTAINER_TIMEOUT_SECONDS=60
CONTAINER_MAX_MEMORY_MB=512
CONTAINER_MAX_CPUS=1.0

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:8000"]
